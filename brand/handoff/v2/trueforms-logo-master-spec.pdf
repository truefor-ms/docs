const theme=document.getElementById('theme'),layout=document.getElementById('layout'),mode=document.getElementById('mode'),size=document.getElementById('size'),logo=document.getElementById('active-logo'),stage=document.getElementById('stage'),download=document.getElementById('download-logo');
const media=window.matchMedia('(prefers-color-scheme: dark)');
const surfaces={color:'#F8F7F2',dark:'#183C32',mono:'#F8F7F2',black:'#FFFFFF',white:'#183C32'};
function resolvedTheme(){return theme.value==='auto'?(media.matches?'dark':'light'):theme.value;}
function update(){const t=resolvedTheme();document.documentElement.dataset.theme=t;const m=mode.value==='auto'?(t==='dark'?'dark':t==='mono'?'black':'color'):mode.value;logo.src=assets[layout.value][m];logo.style.width=size.value+'px';stage.style.background=surfaces[m];download.href=logo.src;download.download='trueforms-logo-'+layout.value.toLowerCase()+'-'+m+'.svg';document.getElementById('width-label').value=size.value+' px';requestAnimationFrame(()=>{document.getElementById('lab-status').textContent=layout.value+' / '+m+' Â· gerÃ§ek geniÅŸlik '+Math.round(logo.getBoundingClientRect().width)+' px';});const header=document.getElementById('header-logo');if(header)header.src=assets.B[t==='dark'?'dark':t==='mono'?'black':'color'];}
theme.value="light";[theme,layout,mode].forEach(el=>el.addEventListener('change',update));size.addEventListener('input',update);media.addEventListener('change',update);window.addEventListener('resize',update);update();
const color=document.getElementById('inline-color');if(color)color.addEventListener('input',()=>document.getElementById('inline-logo').style.color=color.value);
const form=document.getElementById('demo-form');if(form)form.addEventListener('submit',event=>{event.preventDefault();document.getElementById('form-status').textContent='Ã–rnek kontrol edildi. Veri gÃ¶nderilmedi.';});</script></body></html>
